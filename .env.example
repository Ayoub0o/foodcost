# ---------------------------------------------------------------------------
# FoodCost by PixPlat — environment variables
# Copy to .env.local (never commit real secrets). See DIRECTIVE §1.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, OG tags, hreflang).
NEXT_PUBLIC_SITE_URL=

# Base path the app is served under. FoodCost lives at pixplat.com/foodcost.
NEXT_PUBLIC_BASE_PATH=

# --- Supabase (Postgres, Auth, RLS, Storage) ---
# Public (browser) — safe to expose. Used by the browser + server SSR clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side aliases (optional; fall back to the NEXT_PUBLIC_ values).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. MUST NEVER be exposed to the client bundle (CI check enforced).
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Checkout, Billing Portal, webhooks) ---
# Never commit real secrets. Price IDs are safe to commit via env only (not hard-coded).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Pro Monthly ($12/mo) — FoodCost live price id
STRIPE_PRICE_PRO_MONTHLY=price_1TzlloAp29FH08rECcv43kai
# TODO: create yearly price in Stripe Dashboard, then set this to unhide the yearly toggle
STRIPE_PRICE_PRO_YEARLY=

# --- Email (Resend + React Email) ---
RESEND_API_KEY=

# --- Cron (daily trial/lock + purge jobs; protects cron route handlers) ---
CRON_SECRET=

# --- Sentry (optional locally; required for production error tracking) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Admin bootstrap allowlist (comma-separated emails) ---
ADMIN_EMAILS=

# --- E2E tests (Playwright golden path) ---
# The test user is created/reset via the service-role admin API. Requires a
# reachable Supabase project with the migrations applied. See apps/web/e2e/README.md.
E2E_TEST_EMAIL=e2e-goldenpath@example.com
E2E_TEST_PASSWORD=e2e-Golden-Path-123!
# Optional: port the Playwright web server uses (defaults to 3000).
E2E_PORT=3000
# Shared secret for the E2E session endpoint (/api/e2e/session). Required to run Playwright.
E2E_SETUP_SECRET=
