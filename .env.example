# ---------------------------------------------------------------------------
# FoodCost by PixPlat — environment variables
# Copy to apps/web/.env.local (never commit real secrets).
# Keep in sync with: node scripts/check-env-sync.mjs
# ---------------------------------------------------------------------------

# Deploy flavour: production | staging | preview | development
# staging/preview → robots noindex. production → indexable (unless overridden).
FOODCOST_ENV=development

# Force indexing on/off (overrides FOODCOST_ENV / VERCEL_ENV). Values: true|false
NEXT_PUBLIC_ALLOW_INDEXING=

# Optional version string exposed by /api/health (defaults to package version).
APP_VERSION=0.1.0

# Public site URL (canonical URLs, sitemap, OG, auth redirects).
NEXT_PUBLIC_SITE_URL=https://pixplat.com
# Optional alias used by Stripe return URLs (falls back to NEXT_PUBLIC_SITE_URL).
NEXT_PUBLIC_APP_URL=

# Base path the app is served under. FoodCost lives at pixplat.com/foodcost.
NEXT_PUBLIC_BASE_PATH=/foodcost

# --- Supabase (Postgres, Auth, RLS, Storage) ---
# Public (browser) — safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side aliases (optional; fall back to NEXT_PUBLIC_*).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SECRET — server-only. NEVER expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Checkout, Billing Portal, webhooks) ---
# SECRET
STRIPE_SECRET_KEY=
# SECRET — from `stripe listen` or Dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=
# Pro Monthly ($12/mo) — not a secret; set via env only (do not hard-code in source).
STRIPE_PRICE_PRO_MONTHLY=price_1TzlloAp29FH08rECcv43kai
# TODO: create yearly price in Stripe Dashboard to unhide the yearly toggle
STRIPE_PRICE_PRO_YEARLY=
# Legacy aliases (optional)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# --- Email (Resend) ---
# SECRET
RESEND_API_KEY=
RESEND_FROM=FoodCost <noreply@pixplat.com>
# Optional: notify admins of new support tickets
SUPPORT_NOTIFY_EMAIL=

# --- Cron (daily trial/lock + purge) ---
# SECRET — Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# --- Sentry (optional locally; recommended in production) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# SECRET — build-time sourcemap upload
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Admin bootstrap allowlist (comma-separated emails) ---
ADMIN_EMAILS=

# --- E2E (Playwright) — never enable ALLOW_E2E_ROUTES on production ---
E2E_TEST_EMAIL=e2e-goldenpath@example.com
E2E_TEST_PASSWORD=
E2E_ADMIN_EMAIL=e2e-admin@example.com
E2E_ADMIN_PASSWORD=
E2E_PORT=3000
# SECRET — gates /api/e2e/*
E2E_SETUP_SECRET=
# Must stay unset/false in production deploys
ALLOW_E2E_ROUTES=

# --- Ops scripts (local only) ---
# Base URL for scripts/smoke-test.mjs and load-test-exports.mjs
BASE_URL=http://localhost:3001/foodcost
EXPORT_COOKIE=
CONCURRENCY=4
