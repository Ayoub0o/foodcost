{
  "name": "foodcost-by-pixplat",
  "version": "0.1.0",
  "private": true,
  "description": "FoodCost by PixPlat — bilingual self-serve food cost management micro-SaaS.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev": "npm run dev --workspace apps/web",
    "check:no-service-key": "node scripts/check-no-service-key.mjs",
    "check:env": "node scripts/check-env-sync.mjs",
    "lint:seo": "node scripts/seo-lint.mjs",
    "lint:schema": "node scripts/schema-lint.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "load-test:exports": "node scripts/load-test-exports.mjs",
    "publish:guides": "node scripts/publish-guides.mjs",
    "content:generate": "node scripts/generate-phase5-content.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
